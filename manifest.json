{
  "name": "agent-session-tools",
  "version": "0.1.0",
  "checkpoint_schema": 1,
  "journal_schema": 1,
  "runtime": "Linux Python >=3.11, standard library only",
  "entrypoint": "vault_maintenance.py",
  "portable_entrypoint": "skills/vault-maintenance/scripts/maintain_vault.py",
  "commands": [
    "baseline",
    "run",
    "recover"
  ],
  "default_mode": "dry-run",
  "default_timezone": "America/Boise",
  "default_daily_folder": "Sessions",
  "max_unread_log_bytes": 8388608,
  "verified_native_log_source": "obsidian-headless 0.0.14",
  "coverage": "Complete native Sync records since explicit cursor baseline; no retrospective sweep",
  "excluded_capabilities": [
    "content curation",
    "summaries",
    "article fetching",
    "automatic scheduler installation",
    "HTML link rewrite",
    "anchor validation"
  ],
  "skills": {
    "vault-maintenance": {
      "path": "skills/vault-maintenance/SKILL.md",
      "entrypoint": "skills/vault-maintenance/scripts/maintain_vault.py"
    },
    "source-snapshot": {
      "path": "skills/source-snapshot/SKILL.md",
      "entrypoint": "skills/source-snapshot/scripts/markdown_snapshot.py",
      "default_mode": "dry-run",
      "source_scope": "committed Git tree",
      "authoritative": false,
      "disposable": true,
      "requires": [
        "Python >=3.11",
        "Git"
      ]
    }
  }
}
